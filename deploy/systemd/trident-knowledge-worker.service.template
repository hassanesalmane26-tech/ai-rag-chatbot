[Unit]
Description=TRIDENT AI Knowledge Worker
After=network-online.target postgresql.service trident-backend.service
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__RELEASE_ROOT__
EnvironmentFile=/etc/trident/trident-ai.env
ExecStart=__RELEASE_ROOT__/venv/bin/python -m app.knowledge.worker --poll-seconds 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
