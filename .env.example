# Safe placeholders only. Copy locally; never commit real values.
TRIDENT_ENV=development
TRIDENT_DATABASE_URL=postgresql://trident:replace-locally@127.0.0.1:5432/trident
TRIDENT_SECURITY_MODE=disabled

# Required when TRIDENT_SECURITY_MODE=oidc. The issuer must use HTTPS.
TRIDENT_OIDC_ISSUER=https://identity.example.com
TRIDENT_OIDC_AUDIENCE=trident-api
# Optional: omit to use issuer discovery.
TRIDENT_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
TRIDENT_OIDC_ALLOWED_ALGORITHMS=RS256
TRIDENT_OIDC_CLOCK_SKEW_SECONDS=30
TRIDENT_OIDC_HTTP_TIMEOUT_SECONDS=5

# Comma-separated exact browser origins. Wildcards are rejected.
TRIDENT_CORS_ALLOWED_ORIGINS=http://127.0.0.1:10032
